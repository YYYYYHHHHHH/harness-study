{
  "name": "harness-study",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "symphony:install": "bash scripts/symphony/launch.sh install",
    "symphony:doctor": "bash scripts/symphony/launch.sh doctor",
    "symphony:key": "bash scripts/symphony/launch.sh key",
    "symphony:start": "bash scripts/symphony/launch.sh start",
    "symphony:test": "node --test scripts/symphony/check-permissions.mjs scripts/symphony/check-workspace.mjs",
    "start": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "^3.2.7",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "boxen": "^9.0.0",
    "chalk": "^6.0.1",
    "cron-parser": "^5.10.2",
    "js-tiktoken": "^1.0.21",
    "openai": "^7.23.0",
    "ora": "^9.4.1",
    "yaml": "^2.9.1"
  }
}
